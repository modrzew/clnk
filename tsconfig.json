{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* CSS module types, generated into generated/ by css-modules-kit (`cmk`) */
    "rootDirs": [".", "generated"]
  },
  "cmkOptions": { "enabled": true },
  "include": ["src", "shared"],
  "exclude": ["**/*.test.ts"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
